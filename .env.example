# Zkopiruj na .env a vyplň hodnoty:  cp .env.example .env

# Verejna IP VM na tovarni siti (172.24.0.0/21) - stroj sem posila FTP pozadavky.
# Musi to byt IP dosazitelna primo ze stroje (ADDED_FLAGS/PUBLICHOST pro PASV).
VM_PUBLIC_IP=172.24.0.191

# FTP prihlaseni (nastavuje se i na strani stroje, Euromap63/SPI obrazovka)
FTP_USER=euromap
FTP_PASSWORD=ZMEN_ME

# Rozsah PASV portu - musi byt otevreny ve firewallu, pokud nejaky bezi
FTP_PASV_MIN=30000
FTP_PASV_MAX=30009

# Postgres / TimescaleDB
POSTGRES_DB=euromap63
POSTGRES_USER=euromap63
POSTGRES_PASSWORD=ZMEN_ME
POSTGRES_EXPOSE_PORT=5435

# Identifikace stroje v DB (az bude vic stroju, kazdy dostane svuj kod)
MACHINE_CODE=KM-MC5-01

# Oznaceni stejneho stroje v Cyclades MES (pro dohledani aktivni zakazky/OF
# ke kazdemu cyklu). Vyzaduje ~/cyclades-db.env na spc-vm (o uroven vys nez
# tento projekt) - viz README. Prazdne = order_ref se neplni, nic se nerozbije.
CYCLADES_MAC_REFMAC=P2700-01

# Jak casto collector kontroluje REPORTS.DAT (sekundy)
POLL_INTERVAL_SEC=3

# Kdy collector provede rotaci REPORTS.DAT (MB)
ROTATE_SIZE_MB=50

# Porty vystavene na hostu
API_EXPOSE_PORT=8091
FRONTEND_EXPOSE_PORT=8092

# URL, na kterou se bude dotazovat prohlizec uzivatele (musi byt dosazitelna
# z jeho pocitace - typicky http://172.24.0.191:8091)
FRONTEND_API_BASE_URL=http://172.24.0.191:8091
